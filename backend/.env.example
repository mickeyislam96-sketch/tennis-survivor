# Server
PORT=4000
NODE_ENV=production

# Frontend URL (set to your Vercel domain after deploying frontend)
FRONTEND_URL=https://your-app.vercel.app

# Database (Railway auto-populates this when you add a Postgres plugin)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Tennis API (https://api-tennis.com)
TENNIS_API_KEY=your_key_here

# Active tournament
ACTIVE_TOURNAMENT=monte-carlo-2026

# Admin
ADMIN_SECRET=your_admin_secret_here

# Brevo transactional email
BREVO_API_KEY=your_brevo_api_key_here
BREVO_TPL_WELCOME=1
BREVO_TPL_TOURNAMENT_JOIN=2
BREVO_TPL_DRAW_RELEASED=3
BREVO_TPL_PICK_REMINDER=4
BREVO_TPL_SURVIVAL=5
BREVO_TPL_ELIMINATION=6
BREVO_TPL_WINNER=7
BREVO_TPL_PASSWORD_RESET=8
BREVO_TPL_NEW_TOURNAMENT=9
