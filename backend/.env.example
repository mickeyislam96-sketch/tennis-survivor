# Server
PORT=4000
NODE_ENV=production

# Frontend URL (set to your Vercel domain after deploying frontend)
FRONTEND_URL=https://your-app.vercel.app

# Database (Railway auto-populates this when you add a Postgres plugin)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Tennis API (https://api-tennis.com)
TENNIS_API_KEY=your_key_here

# Tournament key (run "npm run find-indian-wells" locally to get this)
INDIAN_WELLS_TOURNAMENT_KEY=your_tournament_key_here
