# Server
PORT=4000
NODE_ENV=production

# Frontend URL (set to your Vercel domain after deploying frontend)
FRONTEND_URL=https://your-app.vercel.app

# Database (Railway auto-populates this when you add a Postgres plugin)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Tennis API (https://api-tennis.com)
TENNIS_API_KEY=your_key_here

# OPTIONAL — Live Tennis API (https://livetennisapi.com) as an extra fallback
# in the dataAdapter chain. Leave unset and nothing changes: the provider is
# skipped entirely. Set the key to have it answer when the scraper, API-Tennis
# and Sofascore all come back empty, or name it in TENNIS_DATA_PROVIDER to try
# it first.
# LIVETENNIS_API_KEY=your_key_here
# LIVETENNIS_TOUR=atp                 # atp | wta | challenger | itf | juniors
# LIVETENNIS_TOURNAMENT=              # override if their event name differs from ours

# Active tournament
ACTIVE_TOURNAMENT=monte-carlo-2026

# Admin
ADMIN_SECRET=your_admin_secret_here

# Brevo transactional email
BREVO_API_KEY=your_brevo_api_key_here
BREVO_TPL_WELCOME=1
BREVO_TPL_TOURNAMENT_JOIN=2
BREVO_TPL_DRAW_RELEASED=3
BREVO_TPL_PICK_REMINDER=4
BREVO_TPL_SURVIVAL=5
BREVO_TPL_ELIMINATION=6
BREVO_TPL_WINNER=7
BREVO_TPL_PASSWORD_RESET=8
BREVO_TPL_NEW_TOURNAMENT=9
